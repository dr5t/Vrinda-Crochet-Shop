generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  orders         Order[]
  reviews        Review[]
  cartItems      CartItem[]
  savedAddresses Address[]
}

model Address {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  name      String
  street    String
  city      String
  state     String
  pinCode   String
  phone     String
  isDefault Boolean @default(false)
}

model Product {
  id             String   @id @default(uuid())
  title          String
  description    String
  price          Float
  stock          Int
  images         String // JSON array as string
  isMadeToOrder  Boolean  @default(false)
  processingTime String? // e.g., "5-7 days"
  variants       String? // JSON array for colors, sizes
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  reviews    Review[]
  orderItems OrderItems[]
  cartItems  CartItem[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  imageUrl String?
  products Product[]
}

model CartItem {
  id        String  @id @default(uuid())
  userId    String
  productId String
  quantity  Int     @default(1)
  variant   String? // Selected variant JSON string

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id              String   @id @default(uuid())
  userId          String
  total           Float
  status          String   @default("Placed") // Placed, Confirmed, Making, Shipped, Delivered, Cancelled
  paymentMethod   String // UPI, Card, Netbanking, COD
  shippingAddress String // JSON string of address
  customNotes     String? // Notes for custom requests
  createdAt       DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id])
  items OrderItems[]
}

model OrderItems {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  variant   String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  imageUrl  String?
  createdAt DateTime @default(now())

  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model SiteConfig {
  id          String   @id @default("default")
  heroTitle   String   @default("Discover Crochet Magic")
  heroSub     String   @default("Unique, handmade crochet pieces.")
  footerText  String   @default("© 2026 Vrinda Crochet. Handcrafted with love.")
  maintenance Boolean  @default(false)
  codEnabled  Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}
